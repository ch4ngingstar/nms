{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "args for wifi_deauth (spec §6.4)",
  "type": "object",
  "required": ["target_bssid", "confirm"],
  "additionalProperties": false,
  "properties": {
    "target_bssid": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$"
    },
    "channel": { "type": "integer", "minimum": 1, "maximum": 14 },
    "duration_s": { "type": "integer", "minimum": 1, "maximum": 60 },
    "bursts": { "type": "integer", "minimum": 1, "maximum": 20 },
    "confirm": { "type": "boolean", "const": true }
  }
}
