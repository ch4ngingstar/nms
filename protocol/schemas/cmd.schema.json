{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cmd data (spec §7.1, §7.2)",
  "type": "object",
  "required": ["job_id", "cmd"],
  "additionalProperties": false,
  "properties": {
    "job_id": { "type": "string", "minLength": 4, "maxLength": 32 },
    "cmd": {
      "enum": ["port_scan", "banner_grab", "dns", "trace", "discover",
               "wifi_survey", "ble_scan", "wifi_ids", "wifi_deauth", "set_monitor", "cancel",
               "identify", "reboot", "get_config"]
    },
    "args": { "type": "object" }
  }
}
